!data/point_data/README.md
!data/point_data/*.csv
!data/paper_reference/
*.mat
**/NYU_Data/**
**/USC_Data/**
**/NYU_Data_thresholded/**

# Raw data (bundled separately but too large for git)
data/raw/*/*
!data/raw/README.md

# Codebase-A 7 GHz intermediate data (6.3 GB, for run_all('cb_a'))
data/raw_cb_a/*/*
!data/raw_cb_a/README.md

# Processing outputs that raw-processing regenerates
matlab/processing/*/Results/
matlab/processing/*/Figures/

