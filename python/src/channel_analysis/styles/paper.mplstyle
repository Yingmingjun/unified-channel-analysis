font.family: serif
font.serif: Times New Roman, DejaVu Serif, serif
font.size: 12
axes.titlesize: 14
axes.labelsize: 14
xtick.labelsize: 12
ytick.labelsize: 12
legend.fontsize: 11

axes.linewidth: 0.8
axes.grid: True
grid.alpha: 0.3
grid.linestyle: :
axes.axisbelow: True

lines.linewidth: 2.0
lines.markersize: 6

figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white
figure.facecolor: white

legend.frameon: True
legend.framealpha: 0.9
legend.edgecolor: 0.5

mathtext.fontset: stix
